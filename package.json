{
  "name": "panorama",
  "description": "Panorama monorepo — Turborepo + pnpm workspaces for the web app and shared packages.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2",
    "lint-staged": "^17.0.5",
    "husky": "^9.1.7",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": "pnpm --dir apps/web exec eslint --fix",
    "packages/ui/**/*.{ts,tsx}": "pnpm --dir packages/ui exec eslint --fix",
    "packages/tokens/**/*.{js,ts}": "pnpm --dir packages/tokens exec eslint --fix",
    "*.{html,css,json}": "prettier --write"
  }
}
