{
  "name": "@repo/prettier-config",
  "version": "0.0.0",
  "description": "Shared Prettier config for the Panorama monorepo.",
  "type": "module",
  "private": true,
  "main": "index.js",
  "exports": "./index.js",
  "scripts": {
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "prettier": "./index.js",
  "peerDependencies": {
    "prettier": "^3.8.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
