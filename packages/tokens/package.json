{
  "name": "@repo/tokens",
  "version": "0.0.0",
  "description": "Production-ready design token system with multi-theme support using Style Dictionary",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm build:tokens",
    "build:tokens": "node config.js --verbose",
    "build:tokens:light": "pnpm build:tokens -- --theme=light",
    "build:tokens:dark": "pnpm build:tokens -- --theme=dark",
    "lint": "eslint",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "eslint": "^9.39.1",
    "prettier": "^3.8.3",
    "globals": "^16.5.0",
    "minimist": "^1.2.8",
    "sass": "^1.97.2",
    "storybook": "^10.1.11",
    "style-dictionary": "^5.1.4"
  }
}
