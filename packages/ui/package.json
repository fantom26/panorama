{
  "name": "@repo/ui",
  "version": "0.2.0",
  "description": "Shared React UI components for Panorama, built with Vite and documented in Storybook.",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.20.2",
    "@amcharts/amcharts5-geodata": "^5.1.6",
    "@base-ui/react": "^1.6.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@repo/tokens": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.11",
    "react-redux": "^9.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check-types": "tsc -b",
    "lint": "eslint",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "init-msw": "msw init public/",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "test": "vitest --run --project storybook",
    "test:watch": "vitest --project storybook"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-themes": "^10.5.6",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "chromatic": "^18.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.11",
    "msw": "^2.12.7",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.3",
    "storybook": "^10.1.11",
    "storybook-design-token": "^5.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
